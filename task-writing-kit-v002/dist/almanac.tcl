}


/* Sight timer phase track @@U+2014@@ 260930-sight-timer-design @@U+00A7@@5 (UD lock A) */
.sight-timer {
  --timer-hue: var(--shed-azure, #568bbf);
  --timer-past: color-mix(in srgb, var(--timer-hue) 55%, var(--ink, #0c161e) 12%);
  --timer-future: color-mix(in srgb, var(--timer-hue) 22%, var(--panel, #e9ecef));
  display: block;
  width: 100%;
  margin: 0.45rem 0 0; /* top gap only; bottom inset from card padding */
  padding: 0 0.1rem;
  box-sizing: border-box;
  overflow-x: hidden; /* belt with JS label clamp */
}

.sight-timer--azure { --timer-hue: #568bbf; }
.sight-timer--amber { --timer-hue: #bf8b56; }
.sight-timer--green { --timer-hue: #56bf8b; }
.sight-timer--violet { --timer-hue: #8b56bf; }
.sight-timer--fuchsia { --timer-hue: #bf568b; }

.sight-timer-track {
  position: relative;
  height: 0.55rem;
  border-radius: 999px;
  background: var(--timer-future);
  border: var(--s-hairline, 1px) solid color-mix(in srgb, var(--timer-hue) 35%, var(--rule, #cfd6dc));
  overflow: visible;
}

.sight-timer-past {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 0%;
  background: var(--timer-past); /* ~500 tier @@U+2014@@ darker than future */
  border-radius: 999px 0 0 999px;
  pointer-events: none;
  transition: width 0.6s linear;
}

.sight-timer-dot {
  position: absolute;
  top: 50%;
  width: 0.42rem;
  height: 0.42rem;
  border-radius: 50%;
  background: var(--ground, #f9fbfb);
  border: 2px solid var(--timer-hue);
  transform: translate(-50%, -50%);
  z-index: 2;
  box-sizing: border-box;
}

.sight-timer-dot--start { left: 0; }
.sight-timer-dot--end { left: 100%; }

.sight-timer-mark {
  position: absolute;
  top: 50%;
  left: 0%;
  width: 0.55rem;
  height: 0.55rem;
  border-radius: 50%;
  background: var(--timer-hue);
  border: 2px solid var(--ground, #f9fbfb);
  box-shadow: 0 0 0 1px color-mix(in srgb, var(--timer-hue) 55%, transparent);
  transform: translate(-50%, -50%);
  z-index: 3;
  transition: left 0.6s linear;
  pointer-events: none;
}

.sight-timer--amber .sight-timer-mark {
  width: 0.62rem;
  height: 0.62rem;
  border-width: 2.5px;
}

.sight-timer--past-end .sight-timer-track {
  border-style: dashed;
}

.sight-timer--past-end .sight-timer-mark {
  /* sit just past end-dot */
  margin-left: 0.35rem;
}

.sight-timer-label {
  position: relative;
  display: inline-block;
  margin-top: 0.2rem;
  transform: translateX(-50%);
  font-family: var(--font-mono, ui-monospace, monospace);
  font-size: 14px; /* was 10@@U+2192@@12; next rung */
  font-weight: 500;
  line-height: 1.2;
  letter-spacing: 0.02em;
  color: color-mix(in srgb, var(--timer-hue) 75%, var(--ink, #0c161e));
  white-space: nowrap;
  max-width: 100%;
  transition: left 0.6s linear;
  pointer-events: none;
}

@media (prefers-reduced-motion: reduce) {
  .sight-timer-past,
  .sight-timer-mark,
  .sight-timer-label {
    transition: none;
  }
}

.tag-meta--domain {
