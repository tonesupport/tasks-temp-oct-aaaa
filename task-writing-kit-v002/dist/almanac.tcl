    state.blocksMode = ('blocksMode' in snap) ? snap.blocksMode : (snap.showBlocked ? 'none' : 'exclude');
    state.doneMode = ('doneMode' in snap) ? snap.doneMode : (state.showDone ? 'none' : 'exclude');
