      syncMapsFromSelection();
    }
    state.lane = snap.lane;
    state.activeAxis = snap.activeAxis;
    state.chipBandOpen = ('chipBandOpen' in snap) ? !!snap.chipBandOpen : false;
    state.showBlocked = snap.showBlocked;
