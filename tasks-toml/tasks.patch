+[mn9k]
+title = 'Add an almanac show verb for single-task lookup by id'
+status = 'later'
+domain = 'almanac'
+notes = '''
+ls and filter have no id filter, so reading one task means listing everything. show <id> should print one task's fields, so all reads and writes can go through almanac.
+Split: ls/filter stay multi-result and field-based (criteria in, zero or more tasks out). show <id> is single-result and identity-based (the id names exactly one task, returns its full fields, no filter logic).
+Related: ls id=<id> currently returns empty with no error, because id is the table name, not a filterable field.
+'''
+created = 2610141134
+updated = 2610141137
+tags = ['task']
